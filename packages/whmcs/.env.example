# Culqi QR - Configuración de ejemplo para WHMCS
# Copia este archivo y configúralo con tus credenciales

# Ambiente
CULQI_ENVIRONMENT=sandbox # sandbox o production

# API Keys de Culqi
# Obtén tus keys en: https://panel.culqi.com/developers/api-keys
CULQI_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxx
CULQI_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx

# Configuración de moneda
CULQI_CURRENCY=PEN # PEN o USD

# Configuración de QR
CULQI_QR_EXPIRATION_MINUTES=15 # Tiempo de vida del QR en minutos

# Opciones
CULQI_AUTO_REDIRECT=yes # Redirigir automáticamente después del pago
CULQI_TEST_MODE=no # Activar logs detallados

# Webhooks (opcional)
# URL de tu callback: https://tudominio.com/modules/gateways/callback/culqiqr.php
# Configúralo en: https://panel.culqi.com/developers/webhooks

# Eventos a suscribir en Culqi:
# - order.status.changed
# - charge.succeeded
# - charge.failed
